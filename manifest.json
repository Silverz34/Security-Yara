{
  "manifest_version": 3,
  "name": "SecureYara",
  "version": "0.1.0",
  "description": "Analiza con reglas YARA los archivos que descargas.",
  "icons": {
    "16": "images/ico_16.png",
    "32": "images/ico_32.png"
  },
  "permissions": ["downloads", "storage","notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SecureYara",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "images/ico_16.png",
      "32": "images/ico_32.png"
    }
  }
}
